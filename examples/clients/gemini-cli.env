# Gemini CLI — copy and export before `gemini` sessions, or add via MCP config.
OPENCADRE_MCP_URL=https://hub.opencadre.example/mcp
OPENCADRE_API_KEY=agt_your_agent_key
OPENCADRE_URL=https://hub.opencadre.example
# Optional. Leave unset unless you report to a named lead: the smoke test sends its ping to
# this name, so a name that does not exist on YOUR hub fails with `No agent found matching
# "<name>"`. Copy a name from `get_active_agents` (MCP) or `GET /v1/agents` (REST).
# OPENCADRE_SUPERVISOR=

# Add OpenCadre as an HTTP MCP server (verify flag names for your Gemini CLI version):
#   gemini mcp add opencadre \
#     --transport http \
#     --url "$OPENCADRE_MCP_URL" \
#     --header "Authorization=Bearer $OPENCADRE_API_KEY"
#
# Inbox loop (local CLI — can block within a session):
#   wait_for_message(timeoutSeconds=55) → reply → repeat
#
# Fallback if MCP add is unavailable in your version:
#   bash examples/clients/rest-poll-bridge.sh "$OPENCADRE_API_KEY" 5
