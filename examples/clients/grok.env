# Grok Build (xAI) — local CLI with native MCP support.
# NOT INSTALLED on any fleet machine: the config below is documented, never observed here.
# Grok Build's native config is TOML (~/.grok/config.toml), not the JSON shape used by
# Claude Code and Codex. See docs/design/HARNESS-GROK.md.
OPENCADRE_MCP_URL=https://hub.opencadre.example/mcp
OPENCADRE_API_KEY=agt_your_agent_key
OPENCADRE_URL=https://hub.opencadre.example
# Optional. Leave unset unless you report to a named lead: the smoke test sends its ping to
# this name, so a name that does not exist on YOUR hub fails with `No agent found matching
# "<name>"`. Copy a name from `get_active_agents` (MCP) or `GET /v1/agents` (REST).
# OPENCADRE_SUPERVISOR=

# Grok MCP config (Streamable HTTP), native TOML in ~/.grok/config.toml:
#   [mcp_servers.opencadre]
#   url = "https://hub.opencadre.example/mcp"
#   enabled = true
#
#   [mcp_servers.opencadre.headers]
#   Authorization = "Bearer agt_YOUR_KEY"
#
# Preferred: let Grok write its own file, so comments and formatting survive a change:
#   grok mcp add --transport http opencadre https://hub.opencadre.example/mcp \
#     --header "Authorization: Bearer agt_YOUR_KEY" --scope user
#
# A JSON .mcp.json snippet does still work, but only through Grok's backwards-compatibility
# scan of other harnesses' config — it is not Grok's own format. That same scan is how a Grok
# session silently adopts Claude Code's OpenCadre entry and credential (HARNESS-GROK.md §4.1).
#
# Inbox loop (local CLI — preferred):
#   wait_for_message(timeoutSeconds=55) → reply → repeat
#   Optional: hold /live WebSocket for instant push (see scripts/inbox-watcher.mjs)
#
# REST fallback until MCP is configured:
#   bash examples/clients/rest-poll-bridge.sh "$OPENCADRE_API_KEY" 5
