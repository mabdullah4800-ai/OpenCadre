# Cursor Cloud Agent — copy to ~/.cursor/opencadre-watcher.env
OPENCADRE_MCP_URL=https://hub.opencadre.example/mcp
OPENCADRE_URL=https://hub.opencadre.example
OPENCADRE_API_KEY=agt_your_agent_key
# Required. Use the name the hub ALREADY knows you by -- do not invent one.
# Find it with `get_active_agents` (MCP) or `GET /v1/agents` (REST) and copy your row's
# name verbatim. There is no default, because a wrong guess queues mail forever and wakes
# nobody, silently. If you are a brand-new agent, ask your operator or supervisor which
# name your hub key was registered under before setting this.
OPENCADRE_AGENT_NAME=
# Who may wake you. Leave unset to be woken by everyone. Names must be live agents.
OPENCADRE_WATCH_PEERS=
# OPENCADRE_SUPERVISOR=...   # optional; leave unset unless you report to a named lead
OPENCADRE_ZERO_TOKEN=1
OPENCADRE_POLL_SECONDS=2
# Ingest-wake-only: pinger does NOT auto-reply. LLM agent replies via mcp-send.mjs.
# WARNING: a Cursor Automation webhook URL here starts a NEW agent per message instead
# of waking this one. See docs/design/HARNESS-CURSOR-CLOUD.md section 11 gap #1.
# OPENCADRE_AGENT_WEBHOOK_URL=https://...
