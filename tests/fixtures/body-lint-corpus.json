{
  "_about": "The differential corpus of the body-fragment lint (src/site-content-lint.ts), read by tests/site-content-lint.test.ts. For each `agree` input, the (element, attribute) pairs tokenizeTags reports must equal the pairs happy-dom's parser builds. For each `diverge` input, happy-dom departs from the WHATWG tokenizer (the `why` says how); there the test pins that tokenizeTags sees every dangerous attribute happy-dom sees (never fewer) and that the lint flags the input. `flag` is whether bodyFragmentProblems must report a problem. Regression evidence, not a proof of browser equivalence.",
  "agree": [
    { "html": "<svg/onload=\"void 0\"></svg>", "flag": true, "note": "PR #730 finding: `/` separates attributes" },
    { "html": "<img/src=\"/a\"/onerror=x>", "flag": true },
    { "html": "<a\thref=\"/x\"\nonclick=y>x</a>", "flag": true, "note": "tab and newline separate attributes" },
    { "html": "<div\fonmouseover=1>x</div>", "flag": true, "note": "form feed separates attributes" },
    { "html": "<div\r\nonclick=x>x</div>", "flag": true, "note": "CRLF is a newline" },
    { "html": "<P ONLOAD=x>x</P>", "flag": true, "note": "attribute names are case-insensitive" },
    { "html": "<A HREF=\"/x\" OnClick=\"y\">x</A>", "flag": true },
    { "html": "<p title=a onclick=b>x</p>", "flag": true, "note": "unquoted values" },
    { "html": "<p title=\"a onload=b\">x</p>", "flag": false, "note": "on* inside a quoted value is not an attribute" },
    { "html": "<p title='a onload=b'>x</p>", "flag": false },
    { "html": "<p title=\"a\"onload=b>x</p>", "flag": true, "note": "no whitespace needed after a quoted value" },
    { "html": "<a title=\"x>y\" onclick=z>x</a>", "flag": true, "note": "a quoted `>` does not end the tag" },
    { "html": "<a title=\"a>b\">ok</a>", "flag": false },
    { "html": "<a title='q\"r' onclick=s>x</a>", "flag": true },
    { "html": "<img src=/a onerror=x", "flag": true, "note": "EOF inside a tag: dropped by the tokenizer, refused by the lint" },
    { "html": "<img src=\"/a onerror=x>", "flag": true, "note": "EOF inside a quoted value" },
    { "html": "< svg onload=x>", "flag": true, "note": "a space after `<` is text; the bare `<` fails closed" },
    { "html": "<svg onload=x/>", "flag": true, "note": "`x/` is the unquoted value" },
    { "html": "<a href=/a href=/b onclick=x>x</a>", "flag": true, "note": "a duplicate attribute" },
    { "html": "<input disabled onfocus=x>", "flag": true, "note": "a valueless attribute, then on*" },
    { "html": "<a/b/c/d onclick=e>x</a>", "flag": true },
    { "html": "<img src=\"/a\" alt=\"x\"/ onerror=y>", "flag": true, "note": "a stray `/` is not self-closing" },
    { "html": "<!-- <img src=/a onerror=x> -->", "flag": false, "note": "a comment" },
    { "html": "<!-- <script>alert(1)</script> -->", "flag": true, "note": "a forbidden element is flagged even inside a comment (conservative)" },
    { "html": "<!-- --!> <img src=/a onerror=x>", "flag": true, "note": "`--!>` ends a comment" },
    { "html": "<!-- -- > <img src=/a onerror=y> -->", "flag": false, "note": "`-- >` does not" },
    { "html": "</p title=\">\"><img src=/a onerror=x>", "flag": true, "note": "an end tag's quoted `>`" },
    { "html": "</ x onclick=y>", "flag": true, "note": "`</` + space is a bogus comment; fails closed" },
    { "html": "<? x <img src=/a onerror=z>", "flag": true, "note": "a processing instruction swallows to the first `>`; fails closed" },
    { "html": "<!x <img src=/a onerror=a>", "flag": true, "note": "a bogus comment; fails closed" },
    { "html": "<svg><a xlink:href=\"/x\" viewBox=\"0 0 1 1\"></a></svg>", "flag": false, "note": "foreign attributes" },
    { "html": "<math><mi onclick=x></mi></math>", "flag": true },
    { "html": "<a href=\"jav&#x61;script:x\">x</a>", "flag": true, "note": "hex character reference in the scheme" },
    { "html": "<a href=\"&#106;avascript:x\">x</a>", "flag": true, "note": "decimal character reference" },
    { "html": "<a href=\"java&Tab;script:x\">x</a>", "flag": true, "note": "named character reference" },
    { "html": "<a href=\"  javascript:x\">x</a>", "flag": true, "note": "leading spaces" },
    { "html": "<a href=\"JAVASCRIPT:x\">x</a>", "flag": true },
    { "html": "<a href=\"/ok?a=1&amp;b=2\">ok</a>", "flag": false, "note": "an encoded ampersand in a relative link is fine" },
    { "html": "<a href=\"https://example.com/a\">ok</a> <img src=\"/shared/a.png\" alt=\"a\">", "flag": false },
    { "html": "<a href=\"/\n/evil.example\">x</a>", "flag": true, "note": "a URL parser drops the newline: `//evil.example`" },
    { "html": "<p STYLE=\"color:red\">x</p>", "flag": true },
    { "html": "<p>ok</p><h2 id=\"a\">Head</h2><ul><li><a href=\"#a\">a</a></li></ul>", "flag": false }
  ],
  "diverge": [
    { "html": "<!--> <img src=/a onerror=x>", "why": "WHATWG: `<!-->` is an abruptly closed empty comment, so the img is a tag; happy-dom keeps the comment open" },
    { "html": "<!---> <img src=/a onerror=x>", "why": "WHATWG: `<!--->` is an abruptly closed empty comment; happy-dom keeps it open" },
    { "html": "<<svg onload=x>", "why": "WHATWG: the first `<` is text and the element is svg; happy-dom names the element `<svg`" },
    { "html": "<a =x onclick=y>x</a>", "why": "WHATWG: a leading `=` is part of the attribute name (`=x`); happy-dom drops it" },
    { "html": "<a x=`y` onclick=z>x</a>", "why": "WHATWG: backticks are part of an unquoted value; happy-dom makes `y` an attribute" },
    { "html": "<a b\"c=d onclick=e>x</a>", "why": "WHATWG: `\"` is part of the attribute name `b\"c`; happy-dom splits it" },
    { "html": "<textarea><img src=/a onerror=x></textarea>", "why": "RCDATA: a browser makes no tags inside <textarea>; happy-dom and the tokenizer both do (neither models RCDATA), so the lint refuses <textarea> outright" },
    { "html": "<p\u0000onclick=x>x</p>", "why": "WHATWG: NUL in a tag name becomes U+FFFD, so there is no onclick; the lint refuses any NUL" }
  ],
  "_aboutValues": "VALUE-level differential (PR #730 re-review): for each `values` input, the URL attribute value bodyFragmentProblems classifies (character references decoded as in an attribute value, then the URL parser's normalisation) equals happy-dom's getAttribute(attr) after the same normalisation, and `reason` is the problem the lint must report. In `valuesDiverge` a browser decodes a reference the lint's table does not hold, so the lint fails closed (the `why` says how); there the input must still be flagged.",
  "values": [
    { "html": "<a href=\"/&#x2f;other.example/path\">x</a>", "attr": "href", "flag": true, "reason": "not a relative or https", "note": "hex reference to /: protocol-relative" },
    { "html": "<a href=\"/&sol;other.example/path\">x</a>", "attr": "href", "flag": true, "reason": "not a relative or https", "note": "named reference to /" },
    { "html": "<a href=\"/&#92;other.example/path\">x</a>", "attr": "href", "flag": true, "reason": "not a relative or https", "note": "decimal reference to backslash" },
    { "html": "<a href=\"&#47;&#47;other.example\">x</a>", "attr": "href", "flag": true, "reason": "not a relative or https" },
    { "html": "<a href=\"/&#x5c;x\">x</a>", "attr": "href", "flag": true, "reason": "not a relative or https" },
    { "html": "<a href=\"&#x2F;&#x2F;x\">x</a>", "attr": "href", "flag": true, "reason": "not a relative or https", "note": "upper-case hex" },
    { "html": "<a href=\"/&#47x\">x</a>", "attr": "href", "flag": true, "reason": "not a relative or https", "note": "numeric with no semicolon: still decoded" },
    { "html": "<a href=\"/&sol;&sol;x\">x</a>", "attr": "href", "flag": true, "reason": "not a relative or https" },
    { "html": "<a href=\"/&#x2f;x\">x</a>", "attr": "href", "flag": true, "reason": "not a relative or https" },
    { "html": "<a href=\"/&bsol;x\">x</a>", "attr": "href", "flag": true, "reason": "not a relative or https" },
    { "html": "<a href=\"/&Tab;/evil.example\">x</a>", "attr": "href", "flag": true, "reason": "not a relative or https", "note": "the URL parser strips the tab: //evil.example" },
    { "html": "<a href=\"&#x20;//evil.example\">x</a>", "attr": "href", "flag": true, "reason": "not a relative or https", "note": "leading space trimmed" },
    { "html": "<a href=\"jav&#x61;script:x\">x</a>", "attr": "href", "flag": true, "reason": "not a relative or https" },
    { "html": "<a href=\"&Sol;\">x</a>", "attr": "href", "flag": true, "reason": "unrecognised character reference", "note": "not a real reference, terminated by ;: fails closed" },
    { "html": "<a href=\"/a&unknown;b\">x</a>", "attr": "href", "flag": true, "reason": "unrecognised character reference" },
    { "html": "<a href=\"/a&ampx;\">x</a>", "attr": "href", "flag": true, "reason": "unrecognised character reference", "note": "a browser keeps it literal (amp + alphanumeric); the lint fails closed on any unknown name ending in ;" },
    { "html": "<a href=\"/a&#;b\">x</a>", "attr": "href", "flag": true, "reason": "unrecognised character reference", "note": "&# with no digits: literal to a browser, refused by the lint" },
    { "html": "<a href=\"/a&#1;b\">x</a>", "attr": "href", "flag": true, "reason": "control character" },
    { "html": "<a href=\"/a&#x7f;b\">x</a>", "attr": "href", "flag": true, "reason": "control character" },
    { "html": "<a href=\"/a&#x81;b\">x</a>", "attr": "href", "flag": true, "reason": "control character", "note": "C1 code point with no windows-1252 mapping" },
    { "html": "<img src='/&#x2f;x' alt=''>", "attr": "src", "flag": true, "reason": "not a relative or https", "note": "single-quoted" },
    { "html": "<img src=/&#x2f;x alt=\"\">", "attr": "src", "flag": true, "reason": "not a relative or https", "note": "unquoted" },
    { "html": "<svg><a xlink:href=\"/&#x2f;x\">x</a></svg>", "attr": "xlink:href", "flag": true, "reason": "not a relative or https" },
    { "html": "<a href=\"/ok?a=1&amp;b=2\">x</a>", "attr": "href", "flag": false },
    { "html": "<a href=\"/x?a=1&b=2\">x</a>", "attr": "href", "flag": false, "note": "&b followed by = is no reference: literal" },
    { "html": "<a href=\"/x?a=1&ampb=2\">x</a>", "attr": "href", "flag": false, "note": "legacy amp followed by an alphanumeric: literal" },
    { "html": "<a href=\"/x?a=1&amp=2\">x</a>", "attr": "href", "flag": false, "note": "legacy amp followed by =: literal" },
    { "html": "<a href=\"/x?a&lt;b\">x</a>", "attr": "href", "flag": false, "note": "decoded to <, inside a relative path" },
    { "html": "<a href=\"/&sol/x\">x</a>", "attr": "href", "flag": false, "note": "sol has no legacy no-semicolon form: literal" },
    { "html": "<a href=\"/a&amp\">x</a>", "attr": "href", "flag": false, "note": "legacy amp at the end, no semicolon: decoded to &" },
    { "html": "<a href=\"/a&lt/b\">x</a>", "attr": "href", "flag": false, "note": "legacy lt before /: decoded to <" },
    { "html": "<a href=\"/a&amp1\">x</a>", "attr": "href", "flag": false, "note": "legacy amp followed by a digit: literal" },
    { "html": "<a href=\"/guides#x\">x</a>", "attr": "href", "flag": false },
    { "html": "<a href=\"https://code.claude.com/docs/en/hooks\">x</a>", "attr": "href", "flag": false },
    { "html": "<a href=\"/a&#x2d;b\">x</a>", "attr": "href", "flag": false, "note": "a decoded - stays a relative path" },
    { "html": "<a href=\"/a&hyphen;b\">x</a>", "attr": "href", "flag": false, "note": "U+2010" },
    { "html": "<a href=\"/a&#x80;b\">x</a>", "attr": "href", "flag": false, "note": "windows-1252 remap to the euro sign" },
    { "html": "<a href=\"/&colon;&period;&num;&quest;&equals;&percnt;&plus;&comma;&semi;&excl;&lpar;&rpar;&nbsp;&lsqb;&rsqb;&commat;&dollar;&ast;&lowbar;&grave;&apos;&quot;&lt;&gt;\">x</a>", "attr": "href", "flag": false, "note": "every table entry but sol, bsol, Tab, NewLine, amp, hyphen" },
    { "html": "<a href=\"https:&sol;&sol;example.com/a\">x</a>", "attr": "href", "flag": false, "note": "decodes to https://" },
    { "html": "<a href=\"#top\">x</a>", "attr": "href", "flag": false }
  ],
  "valuesDiverge": [
    { "html": "<a href=\"/a&copy;b\">x</a>", "attr": "href", "why": "&copy; is a real reference outside the lint table: a browser decodes it to ©, the lint fails closed" },
    { "html": "<a href=\"/a&copy\">x</a>", "attr": "href", "why": "legacy copy with no semicolon at the end: a browser decodes it, the lint's table lacks it, so it fails closed" },
    { "html": "<a href=\"/a&AMP\">x</a>", "attr": "href", "why": "legacy AMP: a browser decodes it to &, the lint's table holds only lower-case amp, so it fails closed" },
    { "html": "<a href=\"/a&not/\">x</a>", "attr": "href", "why": "legacy not before /: a browser decodes it to ¬, the lint fails closed" }
  ]
}
