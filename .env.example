# Port the HTTP server (REST + MCP + WebSocket) listens on.
PORT=8787

# Where the SQLite database file lives. Use ":memory:" for ephemeral/testing
# only -- never for a real deployment, since every message and agent
# registration would vanish on restart.
OPENCADRE_DB_PATH=./data/opencadre.db

# Required on any public deployment: POST /v1/orgs demands
# "Authorization: Bearer <this token>". With NODE_ENV=production and no token
# set, org creation is disabled entirely. Generate with: openssl rand -hex 32
# It also mints one-time console sign-in links on a hub with no sign-in provider
# (POST /v1/admin/sign-in-links), so whoever holds it can sign in as anyone: treat it as root.
OPENCADRE_ADMIN_TOKEN=

# Requests per minute per agent key (or per IP when unauthenticated), for
# REST and MCP separately. Default 600.
OPENCADRE_RATE_LIMIT_PER_MIN=600

# Milliseconds since last_heartbeat_at before an active agent is auto-suspended
# (status=paused). Default 1800000 (30 minutes). Distinct from the 2-minute
# presence online TTL. Paused agents still authenticate; next heartbeat resumes.
OPENCADRE_STALE_AFTER_MS=1800000

# Phone notifications for clearance requests (Web Push). Off until both keys are set.
# Generate once, straight into the env file (the script won't print to a terminal):
#   node scripts/ops/gen-vapid-keys.mjs >> .env
# New keys make every phone turn notifications on again, so rotate only if the private key leaked.
OPENCADRE_VAPID_PUBLIC_KEY=
OPENCADRE_VAPID_PRIVATE_KEY=
OPENCADRE_VAPID_SUBJECT=mailto:admin@example.com

# Plans and limits. Off by default: every workspace starts on the non-expiring plan. "on" enables the plan, trial and limit engine
# (src/billing.ts); this repository ships no payment provider, so nothing is sold.
OPENCADRE_BILLING=

# Only read when OPENCADRE_BILLING=on. How a new self-serve workspace starts. "card" (the default, the launch behaviour): "No plan yet" until its owner starts
# the 7-day card-required trial in checkout. "cardless": the hub-side 7-day trial with no card (tests and emergencies).
# Any other value is treated as "card" and logged as an error at startup. Existing workspaces are never changed by this.
OPENCADRE_TRIAL_MODE=card
